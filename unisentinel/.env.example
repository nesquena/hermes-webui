# UniSentinel example environment
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
PORT=3000
LOG_LEVEL=info
# Optional: Etherscan API key for ABI lookups
ETHERSCAN_API_KEY=

# Example: Governor contract address for on-chain governance events
GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: JSON string of monitored pairs. Format:
# [{"id":"WETH-USDC","pairAddress":"0x...","threshold":5}, ...]
UNISENTINEL_PAIRS=

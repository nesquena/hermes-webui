  "host": "localhost|192.168.0.202",
  "check": "http",
  "endpoint": "/",
  "restart_command": "docker restart container-name",
  "health_interval_minutes": 10,
  "self_heal": true,
  "registered_at": "YYYY-MM-DD"
}
```


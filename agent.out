  local repo="$1" number="$2" url="$3" head_repo="$4" branch="$5" title="$6"
  local slug workdir
  slug="$(printf '%s-%s' "$repo" "$number" | tr '/' '-')"
  workdir="${WORK_ROOT}/${slug}"
  mkdir -p "$WORK_ROOT"
  rm -rf "$workdir"

  log ""
  log "### ${repo}#${number} — ${title}"
  log "- url: ${url}"
  log "- branch: ${head_repo}:${branch}"

  if [ -z "$head_repo" ] || [ -z "$branch" ]; then
    log "- SKIP: no head repository or branch, so there is nothing to push to."
    return 0
  fi

  if ! git clone --quiet "https://x-access-token:${PUSH_PAT}@github.com/${head_repo}.git" "$workdir" 2>&1 | sanitize | tail -3 | tee -a "$LOG"; then
    log "- SKIP: clone failed."
    return 1
  fi
  (
    cd "$workdir"
    git checkout --quiet "$branch" 2>/dev/null || git checkout --quiet -b "$branch" "origin/${branch}"
  ) 2>&1 | sanitize | tee -a "$LOG" || true

  write_context "$workdir/AGENT_CONTEXT.json" "$url"

  local prompt
  prompt="$(cat "$BRIEF")

---

# This run

* upstream object: ${repo}#${number} (${url})
* the pull-request branch is already checked out in the current directory
* machine-readable context for this object: AGENT_CONTEXT.json
* when you are finished, write AGENT_RESULT.json exactly as the brief requires"
  run_agent_in "$workdir" "$prompt" || true

  local result="${workdir}/AGENT_RESULT.json"
  if [ ! -f "$result" ]; then
    log "- REFUSE: the agent left no AGENT_RESULT.json, so nothing is trusted."
    return 1
  fi


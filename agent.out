+def test_launcher_gateway_key_wins_on_the_shared_url(
+    monkeypatch, tmp_path, profile_name, profile_env_body
+):
+    """The launcher credential survives an owner alias and a cloned profile .env.
+
+    Startup state: the launcher exports the shared Gateway URL and
+    ``HERMES_WEBUI_GATEWAY_API_KEY``, and the root ``~/.hermes/.env`` carries
+    the Agent's own ``API_SERVER_KEY``. The Agent clones that root ``.env`` into
+    every new profile, so a cloned profile's copied alias must not replace the
+    launcher credential on the profile's shared URL (the receiver answers 401
+    for the copied key). Asserted on the Authorization header the real worker
+    puts on the wire, for the default profile, a sparse named profile and a
+    cloned named profile.
+    """
+    from api import gateway_chat
+    import api.profiles as profiles
+
+    (tmp_path / ".env").write_text(
+        "API_SERVER_KEY=root-copied-key\n", encoding="utf-8"
+    )
+    for name in ("sparse", "cloned"):
+        (tmp_path / "profiles" / name).mkdir(parents=True)
+    if profile_env_body is not None:
+        (tmp_path / "profiles" / profile_name / ".env").write_text(
+            profile_env_body, encoding="utf-8"
+        )
+
+    monkeypatch.setattr(profiles, "_DEFAULT_HERMES_HOME", tmp_path)
+    monkeypatch.setattr(profiles, "_PROCESS_PROFILE_HOME", str(tmp_path))
+    monkeypatch.setattr(
+        profiles,
+        "_INITIAL_GATEWAY_DEPLOYMENT_ENV",
+        {
+            "HERMES_WEBUI_GATEWAY_BASE_URL": "http://shared-gw.test",
+            "HERMES_WEBUI_GATEWAY_API_KEY": "launcher-key",
+            "HERMES_WEBUI_GATEWAY_USE_RUNS_API": "1",
+        },
+    )
+    monkeypatch.setattr(profiles, "_loaded_profile_env_keys", set())
+    monkeypatch.setattr(gateway_chat, "_GATEWAY_DEPLOYMENT_ENV", {})
+    monkeypatch.setattr(profiles, "list_profiles_api", lambda: [])
+
+    captured = {}
+    with _restored_process_env():
+        profiles._reload_dotenv(tmp_path)
+        assert gateway_chat._GATEWAY_DEPLOYMENT_ENV[
+            "HERMES_WEBUI_GATEWAY_API_KEY"
+        ] == "launcher-key"
+        _capture_gateway_wire_body(
+            None,
+            session_profile=profile_name,
+            real_profile_scope=True,
+            gateway_env={
+                "HERMES_WEBUI_GATEWAY_BASE_URL": "http://shared-gw.test",
+                "HERMES_WEBUI_GATEWAY_API_KEY": "launcher-key",
+            },
+            captured=captured,
+        )
+
+    assert captured["headers"]["Authorization"] == "Bearer launcher-key"
+
+
+@pytest.mark.parametrize(
     ("apply_name", "body"),
     (
         (

codex
Committed one fix on the PR branch; nothing pushed by me.

**What the activity asked for**
- The listed wake items (all on earlier heads) were already resolved at `ab4c5003`, but the newest maintainer review — `CHANGES_REQUESTED` at 09:06Z on the current head, fetched read-only from the PR API — reproduced two CORE regressions against master and gave an explicit fix shape: the reload mirror must never promote a dotenv `API_SERVER_KEY` over an explicit launcher `HERMES_WEBUI_GATEWAY_API_KEY`, and the shared-URL request ladder is profile canonical → launcher canonical → profile alias → shared fallback.

**Change** (`ea0c02fd`, `fix(reasoning): keep the launcher gateway key over a profile alias`)
- `api/profiles.py:1808` — mirror an alias-only dotenv onto the canonical name only when no launcher canonical exists; an explicit dotenv canonical still wins.
- `api/gateway_chat.py:249` — resolve the canonical/legacy key group in the documented order before normalizing both spellings.
- `tests/test_gateway_runs_model_options_boundary.py` — reload-layer precedence tests split (launcher wins / alias owns the group without a launcher canonical), the reversed expectation replaced, and a new HTTP-level test asserting the `Authorization` header the real worker sends for the default, sparse named and cloned named profile.

**Evidence**
- RED before the fix: 5 failures, including `assert 'Bearer root-copied-key' == 'Bearer launcher-key'` for the cloned profile with only the request-layer change reverted.
- GREEN after: boundary file 52 passed, 1 skipped; boundary plus #1879/#716/#5139 in one process 87 passed, 1 skipped; gateway/profile battery 975 passed, 74 skipped; `ruff_lint.py --diff` unchanged (6 findings, all pre-existing, none in touched files); `git diff --check` clean.

**Watch-outs**
- The ladder has no URL condition, as specified: a profile with its own Gateway URL and only an alias key now uses the launcher key there — worth confirming for profile-owned Gateways.
- `test_gateway_approval_runs_api.py` + `test_issue7940_skill_stats_survive_profile_switch.py` in that order fails on a leaked `STREAMS` entry; it fails with this change stashed too, so it is pre-existing.
- The maintainer also asks whether #8241 should narrow to effort delivery; this follows the stated round-9 shape either way.
diff --git a/api/gateway_chat.py b/api/gateway_chat.py
index 38b20d430b94706e3d70d32177f1ea2b1b20b550..396dbafde0343a7481a7c78c9fe476a4490b55d4
--- a/api/gateway_chat.py
+++ b/api/gateway_chat.py
@@ -252,19 +252,24 @@
         return None
     merged = dict(_GATEWAY_DEPLOYMENT_ENV)
     merged.update(profile_environ)
-    # The canonical and legacy Gateway key names are one precedence group.
-    # Exact-key overlay alone can leave a deployment canonical key beside a
-    # profile alias, after which _gateway_api_key() incorrectly prefers the
-    # inherited canonical value. Resolve within the profile layer first, then
-    # normalize both spellings so either downstream reader sees that choice.
-    profile_key = str(
-        profile_environ.get(_WEBUI_GATEWAY_API_KEY_ENV)
-        or profile_environ.get("API_SERVER_KEY")
-        or ""
+    # The canonical and legacy Gateway key names are one precedence group, and
+    # the launcher's explicit canonical key outranks a profile's alias on the
+    # shared Gateway URL (docs/advanced-chat-setup.md). Exact-key overlay alone
+    # let a profile's API_SERVER_KEY — the Agent clones the root .env, whose
+    # alias is its own key, into every new profile — replace the launcher
+    # credential, and the shared receiver answered 401. Resolve the group in
+    # that order, then normalize both spellings so either downstream reader
+    # sees the same choice.
+    profile_canonical = str(profile_environ.get(_WEBUI_GATEWAY_API_KEY_ENV) or "").strip()
+    launcher_canonical = str(
+        _GATEWAY_DEPLOYMENT_ENV.get(_WEBUI_GATEWAY_API_KEY_ENV) or ""
     ).strip()
-    if profile_key:
-        merged[_WEBUI_GATEWAY_API_KEY_ENV] = profile_key
-        merged["API_SERVER_KEY"] = profile_key
+    profile_alias = str(profile_environ.get("API_SERVER_KEY") or "").strip()
+    shared_alias = str(_GATEWAY_DEPLOYMENT_ENV.get("API_SERVER_KEY") or "").strip()
+    resolved_key = profile_canonical or launcher_canonical or profile_alias or shared_alias
+    if resolved_key:
+        merged[_WEBUI_GATEWAY_API_KEY_ENV] = resolved_key
+        merged["API_SERVER_KEY"] = resolved_key
     return merged
 
 

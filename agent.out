run() {
  if [ ! -f "$DELTA" ]; then
    log "No delta report at ${DELTA}; nothing to do."
    exit 0
  fi

  local -a rows=()
  while IFS= read -r line; do
    [ -n "$line" ] && rows+=("$line")
  done < <(read_deltas)

  if [ "${#rows[@]}" -eq 0 ]; then
    log "No actionable delta. Nothing to do."
    exit 0
  fi

  log "# HMA PR Guard - fix run"
  log "- actionable objects: ${#rows[@]}"
  log "- agent: ${FIXER}"
  log "- mode: fix, gate, normal push; no comment, no review, no force"

  local failures=0
  local row
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r repo number url head_repo branch title <<< "$row"
    if ! process_delta "$repo" "$number" "$url" "$head_repo" "$branch" "$title"; then
      failures=$((failures + 1))
    fi
  done

  log ""
  log "## Result"
  log "- handled: ${#rows[@]}"
  log "- failures: ${failures}"
  [ "$failures" -eq 0 ]

def _external_model_alias_lane_response(alias_route, *, external_owned: bool) -> dict | None:
    """Reject alias overrides that the external run protocol cannot express."""
    if not external_owned or alias_route is None:
        return None
    if not (alias_route.get("base_url_explicit") or alias_route.get("credential_explicit")):
        return None
    return {
        "error": "This model alias needs the in-process backend because it overrides an endpoint or credential.",
        "type": "provider_unroutable",
        "reason": "model_alias_requires_in_process_backend",
        "hint": "Use the in-process chat backend or select a provider-only model alias.",
        "_status": 400,
    }


def _runner_reasoning_effort_for_session(session, *, model=None, model_provider=None):
    """Resolve the runner override under the session's authoritative profile."""
    from api.gateway_chat import _gateway_reasoning_effort_for_request

    def _resolve():
        # Same capture rule as _gateway_request_settings_for_session:
        # get_config_snapshot() copies under the cache lock, so a concurrent
        # default-profile read cannot swap this lane's resolved settings.
        return _gateway_reasoning_effort_for_request(
            get_config_snapshot(),
            model=model,
            model_provider=model_provider,
        )

    profile_name = str(getattr(session, "profile", "") or "").strip()
    if not profile_name:
        return _resolve()
    with profile_scope_for_detached_worker(
        profile_name,
        "runner reasoning request settings",
        logger_override=logger,
    ):
        return _resolve()



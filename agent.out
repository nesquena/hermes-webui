from playwright.sync_api import sync_playwright

HOLD_SETUP = \"\"\"() => {
  const row0 = document.querySelector('.session-child-session[data-sid=\"fork-child\"]');
  const btn0 = row0.querySelector('.session-child-session-main');
  const r = btn0.getBoundingClientRect();
  // long-press completion: arm suppression + open menu (deferred repaint replaces row0)
  row0._skipNextChildOpen = true;
  _projectPickerTeardown = () => document.querySelector('.project-picker').remove();
  _sessionListRepaintDeferredByPicker = true;
  _openSessionActionMenu({session_id: 'fork-child'}, row0);
  const replacement = document.querySelector('.session-child-session[data-sid=\"fork-child\"]');
  const btn = replacement.querySelector('.session-child-session-main');
  const rr = btn.getBoundingClientRect();
  return {x: r.x + r.width/2, y: r.y + r.height/2,
          rx: rr.x + rr.width/2, ry: rr.y + rr.height/2,
          replaced: "'!row0.isConnected && replacement !== row0,
          suppressionCarried: !!replacement._skipNextChildOpen};
}"""

def run(tamper):
    with sync_playwright() as pw:
        b = pw.chromium.launch(headless=True, args=["--no-sandbox", "--disable-dev-shm-usage"])
        page = b.new_page(viewport={"width": 390, "height": 844}, has_touch=True)
        page.set_content('"'<"'!doctype html><html><body><div id="sessionList"></div></body></html>'"')
        page.add_script_tag(content=mod._picker_deferred_fork_release_script())
        page.evaluate(\"paintRows()\")
        info = page.evaluate(HOLD_SETUP)
        cdp = page.context.new_cdp_session(page)
        cdp.send(\"Input.dispatchTouchEvent\", {\"type\": \"touchStart\", \"touchPoints\": [{\"x\": info[\"x\"], \"y\": info[\"y\"]}]})
        page.wait_for_timeout(30)
        if tamper:
            page.evaluate(\"() => { const r = document.querySelector('.session-child-session[data-sid=\\\"fork-child\\\"]'); if (r) delete r._skipNextChildOpen; }\")
        cdp.send(\"Input.dispatchTouchEvent\", {\"type\": \"touchEnd\", \"touchPoints\": []})
        page.wait_for_timeout(120)
        after = page.evaluate(\"() => window.__pickerForkAfterRelease()\")
        # second deliberate tap on the replacement row
        page.touchscreen.tap(info[\"rx\"], info[\"ry\"])
        page.wait_for_timeout(80)
        second = page.evaluate(\"() => window.__pickerForkAfterSecondTap()\")
        b.close()
        return info, after, second

for tamper in (False, True):
    info, after, second = run(tamper)
    print(\"tamper(simulate pre-fix)=\", tamper, \"info=\", info)
    print(\"   after_release=\", after, \"after_second_tap=\", second)

pr-guard.yml
===
name: HMA PR Guard

# Runs on GitHub's own cloud. Nothing here needs the user's machine, the local
# gateway, or any always-on process of theirs.
#
# Cadence: every 30 minutes, offset to :07 and :37.
#
# The offset is deliberate. GitHub runs the schedule event on a best-effort
# basis and says the start of every hour is a high-load window, where a queued
# run can be delayed or dropped. `*/30` fires exactly at :00, the worst minute
# of the hour; :07 and :37 keep the same 30-minute spacing away from it.
#
# A missed tick loses nothing: the scan is idempotent and compares against the
# same stored baseline, so the next tick sees everything that changed.
on:
  schedule:
    - cron: "7,37 * * * *"
  workflow_dispatch:
    inputs:
      force_fix:
        description: "Run the fixing stage even when no delta is actionable"
        type: boolean
        default: false
      smoke:
        description: "Install the fixing agent and run a one-off smoke test instead of fixing"
        type: boolean
        default: false

permissions:
  contents: write

concurrency:
  group: pr-guard
  cancel-in-progress: false

jobs:
  probe:
    name: Probe secrets
    runs-on: ubuntu-latest
    outputs:
      pusher: ${{ steps.p.outputs.pusher }}
      agent: ${{ steps.p.outputs.agent }}
      notifier: ${{ steps.p.outputs.notifier }}
    steps:
      - id: p
        env:
          HAS_PUSH: ${{ secrets.PUSH_PAT != '' }}
          HAS_AGENT: ${{ secrets.AGENT_API_KEY != '' }}
          HAS_HOOK: ${{ secrets.DISCORD_WEBHOOK_URL != '' }}
        run: |
          echo "pusher=$HAS_PUSH"   >> "$GITHUB_OUTPUT"
          echo "agent=$HAS_AGENT"   >> "$GITHUB_OUTPUT"
          echo "notifier=$HAS_HOOK" >> "$GITHUB_OUTPUT"

  scan:
    name: Scan every open PR and issue
    runs-on: ubuntu-latest
    outputs:
      changed: ${{ steps.scan.outputs.changed }}
      actionable: ${{ steps.scan.outputs.actionable }}
    steps:
      - uses: actions/checkout@v4

      - name: Scan
        id: scan
        env:
          # The scan needs the search API; GitHub permits fine-grained tokens
          # only `/search/labels` there, so PUSH_PAT cannot serve it (measured
          # 2026-10-07: a scan on PUSH_PAT found 0 objects). Built-in token.
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          python3 scripts/scan.py --root .
          cat report/summary.md >> "$GITHUB_STEP_SUMMARY"

      - name: Commit the refreshed baseline (only when it moved)
        run: |
          set -euo pipefail
          git config user.name  "hma-pr-guard"
          git config user.email "hma-pr-guard@users.noreply.github.com"


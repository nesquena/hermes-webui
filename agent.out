/bin/bash -lc "sed -n '280,360p' /home/runner/work/hma-pr-guard/hma-pr-guard/scripts/fix-stage.sh" in /home/runner/work/_temp/hma-pr-guard-work/nesquena-hermes-webui-6713
 succeeded in 0ms:
  case "$status" in
    nothing)
      log "- nothing to do on this object."
      return 0
      ;;
    blocked)
      log "- blocked; leaving the branch untouched."
      return 0
      ;;
    fixed) : ;;
    *)
      log "- REFUSE: unknown status '${status}'."
      return 1
      ;;
  esac

  local changed
  changed="$(
    cd "$workdir" &&
      git status --porcelain |
        grep -vE 'AGENT_RESULT\.json|AGENT_CONTEXT\.json|^R  ' |
        wc -l
  )"
  if [ "$changed" -eq 0 ]; then
    log "- REFUSE: status says fixed but the tree is unchanged."
    return 1
  fi

  local gate_template requires_tests gate_with_tests
  IFS=$'\t' read -r gate_template requires_tests gate_with_tests <<< "$(gate_for "$repo")"
  if [ -z "$gate_template" ]; then
    log "- REFUSE: no verification gate configured for ${repo}; add one to repos.json."
    return 1
  fi

  if ! safe_fragment "$tests"; then
    log "- REFUSE: the test selection contains shell metacharacters."
    return 1
  fi
  if [ "$requires_tests" = "true" ] && [ -z "$tests" ]; then
    log "- REFUSE: ${repo} requires an explicit test selection and the agent gave none."
    return 1
  fi
  if [ -n "$tests" ] && [ -n "$gate_with_tests" ]; then
    gate_template="$gate_with_tests"
  fi
  gate="${gate_template//\{tests\}/$tests}"
  log "- gate: \`${gate}\`"
  set +e
  ( cd "$workdir" && bash -c "$gate" ) > "${workdir}/gate.out" 2>&1
  local gate_rc=$?
  set -e
  sanitize < "${workdir}/gate.out" | tail -40 | tee -a "$LOG"
  if [ "$gate_rc" -ne 0 ]; then
    log "- GATE FAILED (exit ${gate_rc}); the local changes are discarded and nothing is pushed."
    ( cd "$workdir" && git checkout -- . && git clean -fd >/dev/null 2>&1 ) || true
    return 1
  fi
  log "- gate passed."

  if [ -z "$message" ]; then
    log "- REFUSE: no commit_message supplied."
    return 1
  fi
  message="$(printf '%s' "$message" | head -1 | cut -c1-200)"

  set +e
  (
    cd "$workdir" &&
      git add -A &&
      git -c user.name="${GIT_AUTHOR_NAME:-pxxD1998}" \
          -c user.email="${GIT_AUTHOR_EMAIL:-pxxD1998@users.noreply.github.com}" \
          commit --quiet -m "$message" &&
      git push --quiet origin "HEAD:refs/heads/${branch}"
  ) 2>&1 | sanitize | tee -a "$LOG"
  local push_rc=${PIPESTATUS[0]}
  set -e
  if [ "$push_rc" -ne 0 ]; then
    log "- push failed (exit ${push_rc}); the branch was left as it was. No force, ever."
    return 1
  fi

